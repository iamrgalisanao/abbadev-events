APP_NAME="ABBADev Events"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.abbadev.com

APP_LOCALE=en
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abbadev_events
DB_USERNAME=abbadev_events
DB_PASSWORD=

# --- Session / cache / queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Receipts are stored on the private local disk (storage/app/private).
FILESYSTEM_DISK=local

# The confirmation email is sent by n8n, so Laravel's own mailer can stay 'log'.
MAIL_MAILER=log

# --- GCash pay-to details (keep in sync with the /seminar page) ---
GCASH_NUMBER="0928 320 7029"
GCASH_ACCOUNT_NAME="ROM***L G."
GCASH_QR_URL=
RECEIPT_MAX_KB=5120

# --- n8n webhooks (Header Auth bearer tokens) ---
N8N_PAYMENT_CONFIRMED_URL=https://n8nautomation.abbadev.com/webhook/registration-payment-confirmed
N8N_PAYMENT_CONFIRMED_TOKEN=
N8N_REGISTRATION_RECEIVED_URL=
N8N_REGISTRATION_RECEIVED_TOKEN=
N8N_TIMEOUT=10

# --- CORS: the marketing site origins allowed to call this API ---
CORS_ALLOWED_ORIGINS="https://abbadev.com,https://www.abbadev.com"
