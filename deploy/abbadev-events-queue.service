# Optional: systemd unit for a queue worker.
# Phase 1 calls n8n synchronously in the admin action, so this is only needed if
# you move n8n/email dispatch onto the queue (QUEUE_CONNECTION=database).
#
# Install: copy to /etc/systemd/system/abbadev-events-queue.service, then
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now abbadev-events-queue

[Unit]
Description=ABBADev Events queue worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/abbadev-events
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
